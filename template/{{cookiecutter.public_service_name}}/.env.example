# {{ cookiecutter.public_service_name }} — required env vars
#
# Copy to `.env` and fill in. Every value here has a sane default for
# `./scripts/dev.sh` to work out of the box; production deployments
# override via their own secret management.

# --- Database ----------------------------------------------------------------

# Async DSN used by services/api and services/worker.
# For local dev, this matches the docker-compose `db` service.
DATABASE_URL=postgresql+asyncpg://{{ cookiecutter.python_package }}:{{ cookiecutter.python_package }}@db:5432/{{ cookiecutter.python_package }}

# Sync DSN used by services/migrator (Alembic). Same Postgres, different
# driver. The compose stack derives this automatically; override only if
# you're running migrations against a different DB.
SYNC_DATABASE_URL=postgresql://{{ cookiecutter.python_package }}:{{ cookiecutter.python_package }}@db:5432/{{ cookiecutter.python_package }}

# --- Redis -------------------------------------------------------------------

# Redis is the default queue broker (RQ) and a cache. Compose maps this to
# the `redis` service.
REDIS_URL=redis://redis:6379/0

# --- API ---------------------------------------------------------------------

# Where the API runs.
API_HOST=0.0.0.0
API_PORT=8000

# Identity. `none` = no-auth dev stub (returns a hardcoded test user).
# Real values land when the Grid identity adapter ships in blueprint
# Phase 4. See ./CLAUDE.md and blueprint/docs/SPIKES.md.
AUTH_MODE=none

# CORS — comma-separated origins allowed to hit the API. The dev origins
# below match the Flutter web ports in scripts/flutter-run.sh.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Frontends ---------------------------------------------------------------

# Where Flutter web builds and `flutter run -d chrome` find the API.
# Override per environment (preview deploys, prod, etc.).
API_BASE_URL=http://localhost:8000

# --- Logging / observability -------------------------------------------------

LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Object storage (Phase 4 onwards) ---------------------------------------

# Local default writes to ./storage/. Replace with S3/GCS/R2 credentials
# via the storage Grid adapter once that ships.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
