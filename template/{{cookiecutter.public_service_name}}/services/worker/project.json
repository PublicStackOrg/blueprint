{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "worker",
  "projectType": "application",
  "sourceRoot": "services/worker/worker",
  "tags": ["service:python", "service:worker"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "commands": ["poetry install"], "cwd": "services/worker" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "commands": ["poetry run ruff check worker/ tests/"], "cwd": "services/worker" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "commands": ["poetry run pytest"], "cwd": "services/worker" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "commands": ["docker build -f services/worker/Dockerfile -t worker:dev ."], "cwd": "." }
    }
  }
}
