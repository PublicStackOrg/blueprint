# --- Secrets / env -----------------------------------------------------------
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# --- Node / NX ---------------------------------------------------------------
node_modules/
.nx/
.nx-cache/
.yarn-cache/

# --- Flutter -----------------------------------------------------------------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/Pods/
**/Podfile.lock
**/*.iml
