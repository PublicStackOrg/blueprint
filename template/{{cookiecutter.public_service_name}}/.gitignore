# --- Docker / data (root-level only — anchored, so we don't accidentally
# ignore Python packages or modules named the same thing) ------------------
/storage/
/postgres-data/
/redis-data/

# --- IDE ---------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Claude Code (managed by ../install.sh) ---------------------------------
.claude/
