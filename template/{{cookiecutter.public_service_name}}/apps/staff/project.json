{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "staff",
  "projectType": "application",
  "sourceRoot": "apps/staff/lib",
  "tags": ["app:flutter", "app:staff"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "commands": ["flutter pub get"], "cwd": "apps/staff" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "commands": ["flutter analyze"], "cwd": "apps/staff" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "commands": ["flutter test"], "cwd": "apps/staff" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "commands": ["flutter build web --release"], "cwd": "apps/staff" }
    }
  }
}
