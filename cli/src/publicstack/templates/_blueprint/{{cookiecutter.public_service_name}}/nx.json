{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/**/__pycache__/**/*"
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "build": {
      "cache": true,
      "inputs": ["production", "^production"]
    }
  },
  "defaultBase": "main"
}
