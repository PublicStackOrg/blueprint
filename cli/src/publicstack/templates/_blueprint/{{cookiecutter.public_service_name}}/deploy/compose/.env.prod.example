# {{ cookiecutter.public_service_name }} — production env file template.
#
# Copy to `.env.prod` (gitignored), fill in the secrets, then:
#   docker compose -f deploy/compose/prod.yml --env-file .env.prod up -d
#
# DNS for PUBLIC_HOSTNAME must already point at this VPS — Caddy needs it to
# acquire a Let's Encrypt certificate on first boot.

# --- Required ---------------------------------------------------------------

PUBLIC_HOSTNAME=parking.example.org
IMAGE_TAG=latest

# Strong, randomly-generated passwords. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Caddy basicauth-format string for the /metrics endpoint.
# Generate with `caddy hash-password`.
# Example: METRICS_BASIC_AUTH=metrics $2a$14$abc...xyz
METRICS_BASIC_AUTH=

# --- Identity ---------------------------------------------------------------

# `none` ships a no-auth dev stub. Real Grid identity adapters (Keycloak /
# ZITADEL / Authentik / Auth0 / Clerk / Cognito) plug in here once chosen.
# See blueprint/grid/identity/ + SPIKES.md #2.
AUTH_MODE=none

# --- Grid backends ----------------------------------------------------------

AUDIT_BACKEND=postgres
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_LOCAL_ROOT=/var/lib/{{ cookiecutter.python_package }}/document_storage
NOTIFICATIONS_BACKEND=log_only
PAYMENTS_BACKEND=log_only
ACCESSIBILITY_BACKEND=in_memory

# --- Observability ----------------------------------------------------------

LOG_LEVEL=INFO

# OpenTelemetry. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable trace
# export, or point at a collector (e.g., http://otel-collector:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false
